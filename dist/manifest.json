{
  "manifest_version": 3,
  "name": "Odoo Domain Builder",
  "version": "1.1.0",
  "description": "Choose Odoo models and fields to visually build, validate, and copy domain expressions.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Odoo Domain Builder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "minimum_chrome_version": "116"
}
